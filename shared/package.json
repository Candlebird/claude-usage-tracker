{
  "name": "@ccu/shared",
  "version": "2.0.0",
  "private": true,
  "description": "Shared types, pricing, time and validation helpers for Claude Usage Tracker",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ccu/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
