{
  "name": "claude-usage-tracker",
  "private": true,
  "type": "module",
  "description": "Claude Code usage and plan-limit tracker: local sync CLI, Cloudflare Worker + D1 API, GitHub Pages dashboard",
  "workspaces": [
    "shared",
    "worker",
    "sync",
    "web"
  ],
  "scripts": {
    "postinstall": "npm run build -w @ccu/shared",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
